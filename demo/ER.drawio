        <mxCell id="products" value="products&#10;id INT PK&#10;code VARCHAR(40)  UNIQUE&#10;name VARCHAR(200)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=13;fillColor=#ffffff;strokeColor=#1c1c1c;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="310" height="250" as="geometry" />
        </mxCell>
        <mxCell id="production_orders" value="production_orders&#10;id INT AI PK&#10;order_id INT  UNIQUE&#10;launch_date DATE&#10;department VARCHAR(160)&#10;FK order_id → orders.id" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=13;fillColor=#ffffff;strokeColor=#1c1c1c;" vertex="1" parent="1">

<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Заказы">
    <mxGraphModel dx="1000" dy="1200" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="customers" value="customers&#10;id VARCHAR(32) PK&#10;name VARCHAR(200)&#10;inn VARCHAR(32)&#10;address VARCHAR(300)&#10;phone VARCHAR(80)&#10;kind VARCHAR(80)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=13;fillColor=#ffffff;strokeColor=#1c1c1c;" vertex="1" parent="1">
